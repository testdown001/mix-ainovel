# FastAPI 基础配置
SECRET_KEY=请替换为随机且复杂的字符串
ENVIRONMENT=development
DEBUG=true
LOGGING_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 1 天
CORS_ORIGINS=http://localhost:5173  # 多个来源用逗号分隔
ADMIN_DEFAULT_PASSWORD=请替换为安全的管理员密码

# 数据库类型（当前仅支持 mysql）
DB_PROVIDER=mysql

# --------------------------------------------
# 嵌入模型配置（RAG 检索）
# --------------------------------------------
# 嵌入模型提供方，可选 openai 或 ollama
EMBEDDING_PROVIDER=openai
# OpenAI / 兼容服务的 Base URL，留空则复用 OPENAI_API_BASE_URL
EMBEDDING_BASE_URL=
# 嵌入模型专用 Key，留空则复用 OPENAI_API_KEY
EMBEDDING_API_KEY=
# 默认嵌入模型名称，可根据实际情况调整
EMBEDDING_MODEL=text-embedding-3-large
# 向量维度，建议与模型匹配；未确定时请直接删除本行或填写正确整数
# EMBEDDING_MODEL_VECTOR_SIZE=3072
# 若使用 Ollama 本地模型，配置其服务地址与模型名称
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# --------------------------------------------
# 向量检索配置
# --------------------------------------------
VECTOR_TOP_K_CHUNKS=5
VECTOR_TOP_K_SUMMARIES=3
VECTOR_CHUNK_SIZE=480
VECTOR_CHUNK_OVERLAP=120
VECTOR_INGEST_CONCURRENCY=4
VECTOR_UPSERT_CONCURRENCY=8
RAG_RETRIEVAL_MODE=vector
RAG_BM25_WEIGHT=0.4

# --------------------------------------------
# Reranker 配置（可选）
# --------------------------------------------
# ⚠️ 以下四项只是**首次启动的种子值**，会被写入 SystemConfig 的 rerank.* 键。
#    之后请在后台「接口管理 → 重排序模型」修改（含「测试连接」按钮），改完即时生效；
#    改这里对已初始化的数据库无效。
# 启用后会在检索召回结果上做二次精排
RAG_RERANKER_ENABLED=false
# 请填**完整的 rerank 端点**，原样请求、不做路径拼接（各家路径不同：
#   /v1/rerank、/v1/rerank/multimodal …）。留空才会退回借用 EMBEDDING_BASE_URL 并补 /rerank。
RAG_RERANKER_API_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=jina-reranker-v3

# --------------------------------------------
# Qdrant 向量数据库配置（统一向量存储：RAG + Mem0 长期记忆）
# --------------------------------------------
# QDRANT_HOST=127.0.0.1  # 留空则禁用向量库（RAG + Mem0）
QDRANT_PORT=6333
# QDRANT_API_KEY=

# MySQL 数据库连接
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=arboris

# Redis 缓存配置（需要密码时请使用 redis://:password@host:port/db）
REDIS_URL=redis://localhost:6379/0
# Go Gateway 任务进度回调共享密钥；启用 Gateway 内部回调校验时需与 gateway 配置一致
TASK_DISPATCHER_INTERNAL_CALLBACK_SECRET=

# 管理员初始化账号（首次启动自动写入数据库）
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
ADMIN_DEFAULT_EMAIL=admin@example.com

# 默认 LLM 配置（首次启动写入 system_configs 表，之后可在后台修改）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
WRITER_CHAPTER_VERSION_COUNT=2

# 邮件发送通道（发送验证码用）：smtp（自建 SMTP）或 resend（Resend API）。
# 仅作首次启动时写入 SystemConfig 的种子值，运行时以后台「邮件服务」配置为准。
EMAIL_PROVIDER=smtp

# SMTP 邮件发送配置（EMAIL_PROVIDER=smtp 时使用）
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=小说生成器

# Resend 邮件发送配置（EMAIL_PROVIDER=resend 时使用）
# RESEND_FROM 的域名须已在 Resend 后台完成验证（SPF/DKIM）
RESEND_API_KEY=
RESEND_FROM=验证码 <noreply@yourdomain.com>

# 注册与第三方登录开关
ALLOW_USER_REGISTRATION=true
ENABLE_LINUXDO_LOGIN=false

# Linux.do OAuth 配置信息（启用时请填写真实值）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=https://your-domain.com/api/auth/linuxdo/register
LINUXDO_AUTH_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_USER_INFO_URL=https://connect.linux.do/api/user
