# ===================================================================
# Docker Compose 环境变量配置示例
# ===================================================================
#
# 使用说明：
# 1. 将此文件复制为 .env 文件: `cp .env.example .env`
# 2. 根据您的实际需求，仔细检查并修改以下配置项。
#
# 两套部署栈（按需选其一）：
#   · 单容器栈  docker compose up -d
#        app + qdrant；连宿主机 MySQL（host.docker.internal）；无 Go 网关，故 /ws、/tasks 不可用。
#   · 生产栈    docker compose -f docker-compose.prod.yml up -d --build
#        Nginx + Go 网关 + 多实例 + 自带 MySQL/Redis/Qdrant；需额外变量，见文件末尾 G 段。
#
# HTTP 对外务必设 FORCE_HTTPS_REDIRECT=false（见下）；HTTPS 启用步骤见 deploy/nginx.conf 顶部说明。
#
# ===================================================================

# -------------------------------------------------------------------
# A. 核心应用配置
# -------------------------------------------------------------------
# [必需] 应用对外暴露的网络端口
APP_PORT=8088

# [必需] 用于 JWT token 等安全功能的加密密钥。
# 警告：为了生产环境的安全，请务必将其修改为一个长且随机的复杂字符串！
# 您可以使用此命令生成: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-me-to-random-string

# [可选] CORS 允许的来源，多个用逗号分隔（生产环境务必填写实际域名）
CORS_ORIGINS=https://your-domain.com

# [可选] 应用环境，设置为 "development" 可以启用更详细的调试日志
ENVIRONMENT=production

# [可选] 是否开启调试模式，生产环境中应始终为 "false"
DEBUG=false

# [重要] 生产模式(DEBUG=false)下是否强制 HTTP→HTTPS 跳转。
# 以 HTTP 对外（内网/未配置证书）时必须设为 false，否则 FastAPI 会把请求 308 跳转到
# 不存在的 https，导致全站打不开；已在 nginx/LB 终止 TLS 并透传 X-Forwarded-Proto=https 时设为 true。
FORCE_HTTPS_REDIRECT=false

# [可选] 控制应用日志级别，可选值：CRITICAL/ERROR/WARNING/INFO/DEBUG/NOTSET
LOGGING_LEVEL=INFO


# -------------------------------------------------------------------
# B. 数据库配置
# -------------------------------------------------------------------
# [必需] 数据库类型。当前仅支持 "mysql"。
DB_PROVIDER=mysql

# --- MySQL 配置 ---
# 默认值用于连接宿主机上的 MySQL（通过 host.docker.internal）。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=arboris
MYSQL_PASSWORD=your-database-password-change-me
MYSQL_DATABASE=arboris


# -------------------------------------------------------------------
# C. 初始化管理员账户
# -------------------------------------------------------------------
# 应用首次启动时，将使用以下凭据创建默认的管理员账户。
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=请替换为安全的管理员密码
ADMIN_DEFAULT_EMAIL=admin@example.com


# -------------------------------------------------------------------
# D. 大语言模型 (LLM) 与 RAG 配置
# -------------------------------------------------------------------
# --- D1. 主要生成模型配置 ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=your-model-here
WRITER_CHAPTER_VERSION_COUNT=2

# [可选] SSL 证书验证。使用自签名证书的 API 代理时设为 false
# 可选值: true (默认) | false (跳过验证) | /path/to/ca.pem (自定义 CA)
# LLM_SSL_VERIFY=false

# --- D2. 嵌入模型配置 (用于 RAG 检索) ---
# [必需] 嵌入模型提供方，可选 "openai" 或 "ollama"
EMBEDDING_PROVIDER=openai

# [可选] OpenAI / 兼容服务的 Base URL，如果留空，将复用上方的 OPENAI_API_BASE_URL
EMBEDDING_BASE_URL=https://api.openai.com/v1
# [可选] 嵌入模型专用的 API Key，如果留空，将复用上方的 OPENAI_API_KEY
EMBEDDING_API_KEY=sk-your-api-key-here
# [必需] 默认嵌入模型名称
EMBEDDING_MODEL=text-embedding-3-large
# [必需] 嵌入模型的向量维度，必须与模型匹配；若不确定可保持默认
EMBEDDING_MODEL_VECTOR_SIZE=3072

# [可选] 如果使用 Ollama 本地模型 (EMBEDDING_PROVIDER=ollama)，请配置其服务地址与模型。
OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest


# -------------------------------------------------------------------
# E. 向量检索配置 (用于 RAG)
# -------------------------------------------------------------------
# [可选] RAG 功能依赖 Qdrant 向量数据库。
VECTOR_TOP_K_CHUNKS=5
VECTOR_TOP_K_SUMMARIES=3
VECTOR_CHUNK_SIZE=480
VECTOR_CHUNK_OVERLAP=120
RAG_RETRIEVAL_MODE=vector
RAG_BM25_WEIGHT=0.4

# [可选] 外部 Reranker 精排。⚠️ 只是首次启动的种子值，落库到 SystemConfig 的 rerank.* 后
# 一律以后台「接口管理 → 重排序模型」为准（可开关、可测试连接、改完即时生效）。
RAG_RERANKER_ENABLED=false
# 请填完整的 rerank 端点，原样请求、不拼接路径；留空才回退借用 EMBEDDING_BASE_URL 并补 /rerank
RAG_RERANKER_API_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=jina-reranker-v3

# [可选] 质量回路灰度开关（flagship 档独占，默认关）。打开后各多一次异步 LLM 调用，
# 不阻塞正文生成、失败全程降级。
# 滚动细纲修订：章节定稿后评审后续 K 章大纲是否被本章实际内容写过时，产出修订提示
OUTLINE_REVISION_ENABLED=false
# 卷级复盘重规划：卷末章定稿后对比「本卷原规划 vs 实际写成」，复盘并修订下一卷方向
# （卷级发散卡片不受此开关限制，走 muse_divergence 能力位）
VOLUME_RETROSPECTIVE_ENABLED=false
# 两遍制草稿-改写：先以轻约束写草稿（求好），再据全部规则改写一遍（防错）
# ⚠️ 每章多一次**整章级** LLM 调用，flagship 单章成本近乎翻倍——开启前先算账
TWO_PASS_DRAFT_ENABLED=false
# 人物意义层：定稿后抽取信念变化/代价/关系质变/未言明，作为后续生成的底色注入
# 每章多一次抽取调用（异步、不阻塞正文），比两遍制便宜得多
CHARACTER_SIGNIFICANCE_ENABLED=false


# -------------------------------------------------------------------
# F. 可选服务与功能开关
# -------------------------------------------------------------------
# --- F1. 邮件发送配置 ---
# [可选] 用于发送注册验证、密码重置等邮件。
# 通道选择：smtp（自建 SMTP）或 resend（Resend API）。仅作种子值，运行时以后台「邮件服务」配置为准。
EMAIL_PROVIDER=smtp
# SMTP（EMAIL_PROVIDER=smtp 时使用）
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=拯救小说家
# Resend（EMAIL_PROVIDER=resend 时使用；RESEND_FROM 域名须在 Resend 后台验证 SPF/DKIM）
RESEND_API_KEY=
RESEND_FROM=验证码 <noreply@yourdomain.com>

# --- F2. 功能开关 ---
# 是否允许新用户注册
ALLOW_USER_REGISTRATION=false
# 是否启用 Linux.do 第三方登录
ENABLE_LINUXDO_LOGIN=false

# --- F3. Linux.do OAuth 配置 (如果启用) ---
# 仅当 ENABLE_LINUXDO_LOGIN=true 时需要配置。
LINUXDO_CLIENT_ID=your_client_id
LINUXDO_CLIENT_SECRET=your_client_secret
LINUXDO_REDIRECT_URI=https://your-domain.com/api/auth/linuxdo/register
LINUXDO_AUTH_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_USER_INFO_URL=https://connect.linux.do/api/user


# -------------------------------------------------------------------
# G. 生产栈（docker-compose.prod.yml）追加变量
# -------------------------------------------------------------------
# 仅生产栈需要；单容器栈（docker compose up -d）无需以下变量。
#
# [必需] Go 网关 ↔ 后端 内部任务回调共享密钥，两侧必须一致；
#        未配置会导致内部任务执行端点返回 503。生成：openssl rand -hex 32
TASK_DISPATCHER_INTERNAL_CALLBACK_SECRET=change-me-internal-callback-secret

# [必需] 生产栈自带 MySQL 容器的 root 密码
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# [可选] 生产栈 Redis 连接串（默认连容器内 redis）
REDIS_URL=redis://redis:6379/0

# 说明：
#  · 生产栈中 SECRET_KEY 会同时注入 Go 网关 GATEWAY_JWT_SECRET（两侧自动一致，无需重复配置）。
#  · 生产栈 MYSQL_HOST 默认指向容器内 mysql 服务，无需改为 host.docker.internal。
#  · deploy.replicas 为 Swarm 语法：普通 `docker compose up` 只起单副本，
#    需多副本请用 `docker stack deploy -c docker-compose.prod.yml arboris`。
